# WebGuard AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys as needed.
# WebGuard AI is fully operational WITHOUT any keys in local heuristic analysis mode.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Allowed Frontend Origins (Comma-separated for multiple origins)
# In production, set this to your verified deployment domain, e.g. https://webguard.example.com
# In development, localhost and Chrome Extension origins (chrome-extension://*) are permitted.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (Sliding Window)
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP (default: 60)
RATE_LIMIT_MAX=60

# ─── Optional Threat Intelligence Providers ──────────────────────────────────
# VirusTotal v3 API key — free tier available at https://www.virustotal.com
# Leave blank to run local heuristic and structural analysis without external calls.
VIRUSTOTAL_API_KEY=

# Google Safe Browsing v4 API key — available via Google Cloud Console
# Leave blank to run local heuristic and structural analysis without external calls.
GOOGLE_SAFE_BROWSING_API_KEY=

# ─── Optional Generative AI Explanation Provider ──────────────────────────────
# WebGuard AI uses an internal deterministic rule-based NLG explanation engine by default.
# The default engine requires NO external AI API key and operates completely offline.
AI_EXPLANATION_API_KEY=
AI_EXPLANATION_PROVIDER=

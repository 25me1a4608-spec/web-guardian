# WebGuard AI — Frontend Environment Configuration Template
# ==============================================================================
# Set this variable in your hosting platform (Vercel, Netlify, etc.)
# or copy to frontend/.env for local overrides.
# ==============================================================================

# Production Backend API URL
# Leave blank or omit for local development (defaults to http://localhost:5001)
# When deploying to production, set to your live backend domain:
# VITE_API_BASE_URL=https://webguard-api.onrender.com
VITE_API_BASE_URL=http://localhost:5001


PORT=5001
# HOST: Interface to bind (0.0.0.0 recommended for Docker/Render/Railway)
HOST=0.0.0.0
# NODE_ENV: Set to 'production' in deployed environments
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# In production, set to your verified deployed frontend URL:
# FRONTEND_ORIGIN=https://webguard-ai.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend Production API Base URL (used when building/running the frontend)
# In production, set to your deployed backend URL:
# VITE_API_BASE_URL=https://webguard-api.onrender.com
VITE_API_BASE_URL=http://localhost:5001

# Rate Limiting Configuration (Sliding Window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ─── Optional Threat Intelligence Providers ──────────────────────────────────
# VirusTotal v3 API key — free tier available at https://www.virustotal.com
# Leave blank to run local heuristic and structural analysis without external calls.
VITE_ABUSEIPDB_API_KEY=e85289f6691e95387686c9a7c35a2eff95feb212608ed9c465667bf98275d8aaaaa046fe7b7d4914
GOOGLE_SAFE_BROWSING_API_KEY=

